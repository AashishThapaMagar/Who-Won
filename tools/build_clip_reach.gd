extends SceneTree
## Writes scripts/clip_reach.gd: for each Fighting Animset Pro strike, how
## far forward it reaches (the fist or foot at its furthest ahead of the
## hips, in metres on a fighter of the game's height) and the second it
## gets there in the recording. action_moves.gd sets every move's reach and
## its real timing from them, so a move's hitbox, the AI's spacing and what
## is drawn all agree, and each strike plays at the speed it was performed.
## Only numbers are written, none of the pack itself.
##
##   godot --headless --path . -s res://tools/build_clip_reach.gd
const MODELS := preload("res://scripts/fighter_models.gd")
const FILES := ["KB_Punches", "KB_Kicks", "KB_Crouched", "KB_Specials", "KB_Jumping", "KB_Blocks"]

func _initialize() -> void:
	var reach := {}
	var impact := {}
	var length := {}
	for file in FILES:
		var scene: Node = (load(MODELS.ANIMSET + file + ".fbx") as PackedScene).instantiate()
		var skeleton: Skeleton3D = scene.find_children("*", "Skeleton3D", true, false)[0]
		var player: AnimationPlayer = scene.find_children("*", "AnimationPlayer", true, false)[0]
		for name in player.get_animation_list():
			if not String(name).begins_with("KB_") or reach.has(name):
				continue
			var clip := player.get_animation(name)
			var measured := _reach(skeleton, clip)
			reach[name] = snappedf(measured[0] * MODELS.FIGHTER_HEIGHT / 1.75, 0.01)
			impact[name] = snappedf(measured[1], 0.01)
			length[name] = snappedf(clip.length, 0.01)
		scene.free()
	var names := reach.keys()
	names.sort()
	var tables := {"REACH": reach, "IMPACT": impact, "LENGTH": length}
	var text := "extends RefCounted\n## Generated by tools/build_clip_reach.gd. REACH: metres each Fighting\n## Animset Pro clip's fist or foot reaches ahead of the hips at its furthest.\n## IMPACT: the second it gets there in the recording. LENGTH: clip seconds.\n"
	for table in ["REACH", "IMPACT", "LENGTH"]:
		var lines := PackedStringArray()
		for name in names:
			lines.append('\t"%s": %s,' % [name, tables[table][name]])
		text += "const %s := {\n%s\n}\n" % [table, "\n".join(lines)]
	var file := FileAccess.open("res://scripts/clip_reach.gd", FileAccess.WRITE)
	file.store_string(text)
	file.close()
	print("wrote ", names.size(), " clips")
	quit()

## [furthest reach straight ahead (+Z, the way the pack's fighter faces),
## the second it is reached].
static func _reach(skeleton: Skeleton3D, clip: Animation) -> Array:
	var tracks := {}
	for track in clip.get_track_count():
		var bone := skeleton.find_bone(String(clip.track_get_path(track).get_concatenated_subnames()))
		if bone >= 0 and clip.track_get_type(track) == Animation.TYPE_ROTATION_3D:
			tracks[bone] = track
	var hips := skeleton.find_bone("Hips")
	var limbs := ["LeftHand", "RightHand", "LeftFoot", "RightFoot"].map(func(limb): return skeleton.find_bone(limb))
	var best := 0.0
	var best_time := 0.0
	var time := 0.0
	while time <= clip.length:
		var world := {}
		for bone in skeleton.get_bone_count():
			var local := skeleton.get_bone_rest(bone)
			if tracks.has(bone):
				local.basis = Basis(clip.rotation_track_interpolate(tracks[bone], time))
			var parent := skeleton.get_bone_parent(bone)
			world[bone] = (world[parent] if parent >= 0 else Transform3D()) * local
		for limb in limbs:
			var ahead: float = ((world[limb] as Transform3D).origin - (world[hips] as Transform3D).origin).z
			if ahead > best:
				best = ahead
				best_time = time
		time += 1.0 / 30.0
	return [best, best_time]
