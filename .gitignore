# Godot 4+ specific ignores
# Local service credentials
.env
.env.*
__pycache__/

.godot/
.import/
export_presets.cfg
*.translation

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/

# System / editor files
.DS_Store
Thumbs.db

# Mixamo downloads: usable in the game, but not to be redistributed as raw
# files. Keep them local; fighters without them use the procedural rig.
assets/fighters/*/*.fbx
assets/fighters/*/*.fbx.import
# Bodies built by tools/build_fighter_body.py carry the Mixamo rig too.
assets/fighters/*/body.glb
assets/fighters/*/body.glb.import
assets/fighters/*/meshy_moves.glb
assets/fighters/*/meshy_moves.glb.import
assets/fighters/*/meshy_moves_*
# Textures the glTF export unpacks next to a built body (e.g. its face).
assets/fighters/*/body_*.png
assets/fighters/*/body_*.png.import
assets/fighters/*/body_*.jpg
assets/fighters/*/body_*.jpg.import
assets/fighters/*/style/*.fbx
assets/fighters/*/style/*.fbx.import
assets/fighters/*/capoeira/
assets/fighters/*/mma/
assets/fighters/*/fight/

# Rendered films (scenes/FightFilm.tscn)
renders/

# Boudhanath stupa source (Meshy, 763k triangles): the game uses the baked
# stupa_game.res and its two textures; keep the source local.
assets/arenas/props/stupa/stupa.fbx
assets/arenas/props/stupa/stupa.fbx.import
assets/arenas/props/stupa/stupa_2.png*
assets/arenas/props/stupa/stupa_3.png*
# Monastery building sources (Meshy, millions of triangles): the game uses
# the baked monastery_hall.res / monk_quarters.res and their textures.
assets/arenas/props/stupa/monastery_hall_src.glb
assets/arenas/props/stupa/monastery_hall_src.glb.import
assets/arenas/props/stupa/monk_quarters_src.glb
assets/arenas/props/stupa/monk_quarters_src.glb.import

# Development captures (tools/ui_gallery.gd)
screenshots/

# Phone builds
build/

# Meshy downloads (tools/fetch_meshy_animations.py): kept local like Mixamo.
assets/fighters/meshy/*
!assets/fighters/meshy/rig.json
assets/fighters/*/meshy_body.glb
assets/fighters/*/meshy_body.glb.import
assets/fighters/*/meshy_body_*

# Fighting Animset Pro (Kubold, Unity Asset Store licence): kept local, never committed.
assets/fighters/animset/*
